{
  "name": "@joshualevy029/azure-blob-sdk",
  "version": "0.1.0",
  "description": "SDK Node/TypeScript para o Azure Blob Storage, sem dependências: API fluente, CLI, múltiplas conexões (SAS URL, connection string ou conta+chave) e integrações com NestJS e FlyDrive (AdonisJS Drive).",
  "keywords": [
    "azure",
    "azure-storage",
    "blob",
    "blob-storage",
    "sdk",
    "nestjs",
    "flydrive",
    "adonisjs"
  ],
  "license": "MIT",
  "author": "Joshua Barbosa",
  "homepage": "https://github.com/joshua-barbosa/azure-blob-sdk/tree/main/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshua-barbosa/azure-blob-sdk.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/joshua-barbosa/azure-blob-sdk/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/joshuabarbosa"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs.d.ts",
        "default": "./dist/nestjs.js"
      },
      "require": {
        "types": "./dist/nestjs.d.cts",
        "default": "./dist/nestjs.cjs"
      }
    },
    "./flydrive": {
      "import": {
        "types": "./dist/flydrive.d.ts",
        "default": "./dist/flydrive.js"
      },
      "require": {
        "types": "./dist/flydrive.d.cts",
        "default": "./dist/flydrive.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "nestjs": [
        "./dist/nestjs.d.ts"
      ],
      "flydrive": [
        "./dist/flydrive.d.ts"
      ]
    }
  },
  "bin": {
    "azure-blob": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run test/e2e",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "flydrive": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "flydrive": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/testing": "^12.1.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "flydrive": "^2.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
